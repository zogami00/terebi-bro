<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      First-run / pairing overlay. TV remote navigable.

      ScrollView so a short display (e.g. a 720p TV at ~540dp tall) can never
      clip content: with `fillViewport` the content still centres and looks
      identical when it already fits a tall display, but scrolls (and keeps
      every button focusable) when it does not.
    -->
    <ScrollView
        android:id="@+id/info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/info_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/info_controller_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:text="@string/controller_label" />

            <TextView
                android:id="@+id/info_ip_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:text="@string/ip_label" />

            <!-- Debug-only adb-forward hint; hidden (and unused) in release. -->
            <TextView
                android:id="@+id/info_debug_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textColor="#FFD166"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="24sp"
                android:textColor="#FFD166"
                android:text="@string/pairing_pin_label" />

            <!--
              Advisory only: shown when the system WebView is old enough that
              modern CSS renders as unstyled HTML. It never gates anything.
            -->
            <TextView
                android:id="@+id/info_webview_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textColor="#FFD166"
                android:visibility="gone" />

            <Button
                android:id="@+id/info_pair_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pair_device" />

            <Button
                android:id="@+id/info_revoke_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/revoke_devices" />

            <!--
              Bootstrap for the "extra trusted networks" setting: a client whose
              subnet is blocked cannot reach the controller to configure it, so
              the refused addresses are listed here with a one-press allow.
            -->
            <TextView
                android:id="@+id/info_blocked_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="18sp"
                android:textColor="#FFD166"
                android:visibility="gone"
                android:text="@string/blocked_clients" />

            <LinearLayout
                android:id="@+id/info_blocked_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />

            <TextView
                android:id="@+id/info_networks_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:text="@string/trusted_networks" />

            <LinearLayout
                android:id="@+id/info_networks_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />

            <Button
                android:id="@+id/info_start_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:nextFocusDown="@id/info_exit"
                android:text="@string/start_browser" />

            <!-- Deliberate exit path, works on every API (the only one on API 33+). -->
            <Button
                android:id="@+id/info_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nextFocusDown="@id/info_exit"
                android:text="@string/exit_app" />

        </LinearLayout>

    </ScrollView>

    <!-- Network failure overlay (§21). -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="@string/website_unavailable" />

        <TextView
            android:id="@+id/error_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:text="" />

        <Button
            android:id="@+id/error_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/retry_now" />

        <Button
            android:id="@+id/error_home_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home" />

    </LinearLayout>

    <!--
      On-device menu (spec §15). Opened by a long press of Back where the hold
      is observable (API ≤ 32) or by the remote's MENU / INFO key on any API.
      Back closes it. Every item is focusable, so it is fully D-pad navigable;
      the ScrollView keeps every item reachable on a short display.
    -->
    <ScrollView
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <Button
                android:id="@+id/menu_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_home" />

            <Button
                android:id="@+id/menu_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_reload" />

            <Button
                android:id="@+id/menu_refresh_webview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_refresh_webview" />

            <Button
                android:id="@+id/menu_enter_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_enter_url" />

            <Button
                android:id="@+id/menu_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_settings" />

            <Button
                android:id="@+id/menu_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_device_info" />

            <Button
                android:id="@+id/menu_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/exit_app" />

        </LinearLayout>

    </ScrollView>

    <!-- Read-only device information (spec §15 menu item), opened from the menu. -->
    <LinearLayout
        android:id="@+id/device_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/device_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />

        </ScrollView>

        <Button
            android:id="@+id/device_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/close" />

    </LinearLayout>

</FrameLayout>
